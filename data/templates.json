        "Faq": {
          "variants": {
            "PetFaq2": {
              "subtitle": "FAQ",
              "title1": "Frequently Asked",
              "highlightedTitle": "Questions",
              "description": "Find quick answers to common questions about our pet care services, appointments, facilities, and more. If you need further assistance, feel free to contact our team.",
              "expandLabel": "Expand answer",
              "collapseLabel": "Collapse answer",
              "items": [
                {
                  "id": "faq-services",
                  "number": "1.",
                  "question": "Do I need an appointment for a consultation?",
                  "answer": "While walk-ins are welcome, we recommend scheduling an appointment to ensure minimal waiting time and dedicated attention for your pet. Appointments help us provide a better and more personalized experience."
                },
                {
                  "id": "faq-grooming-safety",
                  "number": "2.",
                  "question": "What types of pets do you treat?",
                  "answer": "Our team provides compassionate care for dogs, cats, and many common companion pets. Contact us before booking if your pet has specialized care requirements."
                },
                {
                  "id": "faq-pet-boarding",
                  "number": "3.",
                  "question": "What services are included in a routine checkup?",
                  "answer": "A routine checkup includes a physical examination, weight and wellness review, preventive-care guidance, and recommendations tailored to your pet."
                },
                {
                  "id": "faq-daycare-timings",
                  "number": "4.",
                  "question": "Are vaccinations necessary for indoor pets?",
                  "answer": "Yes. Vaccinations help protect indoor pets from preventable illnesses that can still enter the home through people, other animals, or unexpected exposure."
                },
                {
                  "id": "faq-book-appointment",
                  "number": "5.",
                  "question": "How often should I bring my pet for a health checkup?",
                  "answer": "Most healthy adult pets benefit from a yearly wellness visit, while puppies, kittens, senior pets, and pets with ongoing conditions may need more frequent care."
                },
                {
                  "id": "faq-vaccinations",
                  "number": "6.",
                  "question": "Do you provide grooming services?",
                  "answer": "Yes. We offer gentle grooming, bathing, coat care, nail trimming, and hygiene services suited to your pet\u2019s breed and comfort."
                },
                {
                  "id": "faq-stay-during-grooming",
                  "number": "7.",
                  "question": "What should I do in a pet emergency?",
                  "answer": "Call our team immediately and describe the symptoms. If your pet is in severe distress, seek the nearest emergency veterinary service without delay."
                },
                {
                  "id": "faq-boarding-food-bedding",
                  "number": "8.",
                  "question": "Do you offer nutritional advice for pets?",
                  "answer": "Yes. Our team can recommend balanced nutrition and practical feeding guidance based on your pet\u2019s age, breed, lifestyle, and health needs."
                }
              ],
              "image": "/about/1.webp",
              "imageAlt": "A golden retriever and cat resting together"
            }
          }
        },
